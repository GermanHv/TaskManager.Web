@model TaskSearchViewModel 

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Título</th>
            <th>Categoría</th>
            <th>Step</th>
            <th>Completada</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Result != null)
        {
            foreach (var t in Model.Result.Items)
            {
                <tr>
                    <td>@t.Title</td>
                    <td>@t.CategoryName</td>
                    <td>@t.Step</td>
                    <td>@(t.IsCompleted ? "Sí" : "No")</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@t.Id" class="btn btn-sm btn-info">Ver</a>
                        <button class="btn btn-sm btn-warning btnEdit"
                                data-id="@t.Id">
                            Editar
                        </button>
                        <button class="btn btn-sm btn-danger btnDelete"
                                data-id="@t.Id">
                            Eliminar
                        </button>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

<!--Paginacion con anterior y siguinete-->
@{
    int totalPages = 0;
    int currentPage = 1;
    int startPage = 1;
    int endPage = 1;

    if (Model.Result != null)
    {
        totalPages = (int)Math.Ceiling((double)Model.Result.TotalCount / Model.PageSize);
        currentPage = Model.Page;
        startPage = Math.Max(1, currentPage - 2);
        endPage = Math.Min(totalPages, currentPage + 2);
    }
}

@if (Model.Result != null && totalPages > 1)
{
    <nav class="d-flex justify-content-center mt-3">
        <ul class="pagination">

            <!-- Anterior -->
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a class="page-link page-link-btn" data-page="@(currentPage - 1)">Anterior</a>
            </li>

            @if (startPage > 1)
            {
                <li class="page-item">
                    <a class="page-link page-link-btn" data-page="1">1</a>
                </li>

                @if (startPage > 2)
                {
                    <li class="page-item disabled">
                        <span class="page-link">...</span>
                    </li>
                }
            }

            @for (int i = startPage; i <= endPage; i++)
            {
                <li class="page-item @(currentPage == i ? "active" : "")">
                    <a class="page-link page-link-btn" data-page="@i">@i</a>
                </li>
            }

            @if (endPage < totalPages)
            {
                @if (endPage < totalPages - 1)
                {
                    <li class="page-item disabled">
                        <span class="page-link">...</span>
                    </li>
                }

                <li class="page-item">
                    <a class="page-link page-link-btn" data-page="@totalPages">
                        @totalPages
                    </a>
                </li>
            }

            <!-- Siguiente -->
            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <a class="page-link page-link-btn" data-page="@(currentPage + 1)">
                    Siguiente
                </a>
            </li>

        </ul>
    </nav>
}
